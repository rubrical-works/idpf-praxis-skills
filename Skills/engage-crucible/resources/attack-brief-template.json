{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "attack-brief-template.json",
  "title": "Falsification-attack brief template (engage-crucible)",
  "description": "Slot template the primary agent fills before dispatching each attacker subagent. One attacker per hypothesis (Step 3). The attacker's job is constructive: propose the cheapest experiment that would discriminate the assigned hypothesis from its siblings.",
  "type": "object",
  "required": ["assignedHypothesis", "siblingHypotheses"],
  "properties": {
    "assignedHypothesis": {
      "type": "object",
      "required": ["id", "claim", "predictions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "claim": { "type": "string", "minLength": 1 },
        "predictions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "siblingHypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "predictions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "claim": { "type": "string", "minLength": 1 },
          "predictions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "evidenceTierPreferences": {
      "type": "array",
      "items": { "enum": ["systematic-review", "RCT", "cohort", "observational", "expert", "anecdote"] }
    },
    "offlineMode": { "type": "boolean" },
    "costGuidance": {
      "type": "string",
      "description": "Free-text guidance about constraints (budget, timeline, ethical, regulatory) that bound what 'cheap' means for this run."
    }
  },
  "additionalProperties": false
}
