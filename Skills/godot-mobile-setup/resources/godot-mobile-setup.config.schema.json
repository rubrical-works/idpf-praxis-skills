{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "godot-mobile-setup.config.schema.json",
  "type": "object",
  "required": ["version", "source", "toolRoot", "projectAnswers", "hostSetup", "godot", "builds", "paths", "selfContained", "dotnet", "sdkPackages", "downloads", "items", "verify"],
  "additionalProperties": true,
  "definitions": {
    "toolRootPath": {
      "type": "string",
      "pattern": "^\\{toolRoot\\}/[^\\\\]*$",
      "description": "A path derived from the tool root, forward slashes only."
    },
    "status": { "type": "string", "enum": ["verified", "declared-but-untested"] },
    "os": { "type": "string", "enum": ["windows", "macos", "linux"] },
    "commandOrSteps": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      ]
    },
    "platformEntry": {
      "type": "object",
      "required": ["status", "check", "apply", "requiresAdmin", "requiresReboot"],
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "#/definitions/status" },
        "check": { "type": "string", "minLength": 1 },
        "apply": { "$ref": "#/definitions/commandOrSteps" },
        "requiresAdmin": { "type": "boolean" },
        "requiresReboot": { "type": "boolean" }
      }
    },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "windows": { "$ref": "#/definitions/platformEntry" },
        "macos": { "$ref": "#/definitions/platformEntry" },
        "linux": { "$ref": "#/definitions/platformEntry" }
      }
    },
    "when": {
      "type": "object",
      "description": "Project answers that select the entry. Empty: always applies.",
      "additionalProperties": false,
      "properties": {
        "godotLanguage": { "type": "string", "enum": ["gdscript", "csharp"] },
        "gamePlatform": {
          "type": "array",
          "items": { "type": "string", "enum": ["android", "ios", "both"] },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "kind", "summary", "when", "platforms"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "kind": { "type": "string", "enum": ["tool", "envVar", "folder", "editorSetting"] },
        "summary": { "type": "string", "minLength": 1 },
        "when": { "$ref": "#/definitions/when" },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "platforms": { "$ref": "#/definitions/platforms" }
      }
    },
    "build": {
      "type": "object",
      "required": ["editorArchive", "exportTemplates", "templateFolder"],
      "additionalProperties": false,
      "properties": {
        "editorArchive": {
          "type": "object",
          "required": ["windows", "macos", "linux"],
          "additionalProperties": false,
          "properties": {
            "windows": { "type": "string", "minLength": 1 },
            "macos": { "type": "string", "minLength": 1 },
            "linux": { "type": "string", "minLength": 1 }
          }
        },
        "exportTemplates": { "type": "string", "pattern": "\\.tpz$" },
        "templateFolder": { "type": "string", "minLength": 1 }
      }
    },
    "verifyCheck": {
      "type": "object",
      "required": ["id", "summary", "pass", "platforms"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "summary": { "type": "string", "minLength": 1 },
        "pass": { "type": "string", "minLength": 1 },
        "when": { "$ref": "#/definitions/when" },
        "platforms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^(windows|macos|linux)$": {
              "type": "object",
              "required": ["status", "run"],
              "additionalProperties": false,
              "properties": {
                "status": { "$ref": "#/definitions/status" },
                "run": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "_description": { "type": "string" },
    "version": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["evidence", "pilotStack"],
      "additionalProperties": true
    },
    "toolRoot": {
      "type": "object",
      "required": ["question", "default", "pathSeparator"],
      "additionalProperties": true,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "default": { "type": "null" },
        "pathSeparator": { "const": "/" }
      }
    },
    "projectAnswers": {
      "type": "object",
      "required": ["godotLanguage", "gamePlatform"],
      "additionalProperties": true
    },
    "hostSetup": {
      "type": "object",
      "description": "Published verbatim in this skill's SKILLS-manifest.json entry by build-skills-manifest.js (#394); same shape as hostSetupEntry in SKILLS-manifest-schema.json. Keep hostKeys[].question equal to the question it names, and os in step with the items' platforms statuses.",
      "required": ["hostKeys", "automates", "leavesToUser", "os"],
      "additionalProperties": false,
      "properties": {
        "hostKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "question"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "question": { "type": "string", "minLength": 1 }
            }
          }
        },
        "automates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "leavesToUser": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "os": {
          "type": "object",
          "required": ["verified", "untested"],
          "additionalProperties": false,
          "properties": {
            "verified": { "type": "array", "items": { "$ref": "#/definitions/os" }, "uniqueItems": true },
            "untested": { "type": "array", "items": { "$ref": "#/definitions/os" }, "uniqueItems": true }
          }
        }
      }
    },
    "godot": {
      "type": "object",
      "required": ["version", "status", "releaseBase", "checksums"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        "status": { "type": "string", "minLength": 1 },
        "releaseBase": { "type": "string", "pattern": "^https://.*/$" },
        "checksums": { "type": "string", "minLength": 1 }
      }
    },
    "builds": {
      "type": "object",
      "required": ["gdscript", "csharp"],
      "additionalProperties": true,
      "properties": {
        "gdscript": { "$ref": "#/definitions/build" },
        "csharp": { "$ref": "#/definitions/build" }
      }
    },
    "paths": {
      "type": "object",
      "required": ["downloads", "editor", "editorData", "templates", "sdk"],
      "additionalProperties": { "$ref": "#/definitions/toolRootPath" }
    },
    "selfContained": {
      "type": "object",
      "required": ["markerFile"],
      "additionalProperties": true,
      "properties": { "markerFile": { "type": "string", "minLength": 1 } }
    },
    "dotnet": {
      "type": "object",
      "required": ["minimumMajor"],
      "additionalProperties": true,
      "properties": { "minimumMajor": { "type": "integer", "minimum": 8 } }
    },
    "sdkPackages": {
      "type": "object",
      "required": ["packages"],
      "additionalProperties": true,
      "properties": {
        "packages": {
          "type": "object",
          "description": "Package ids per OS, in the form that OS's pinned sdkmanager accepts.",
          "required": ["windows", "macos", "linux"],
          "additionalProperties": false,
          "properties": {
            "windows": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            "macos": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            "linux": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          }
        }
      }
    },
    "downloads": {
      "type": "object",
      "required": ["cmdlineTools"],
      "additionalProperties": true
    },
    "items": { "type": "array", "items": { "$ref": "#/definitions/item" }, "minItems": 1 },
    "verify": {
      "type": "object",
      "required": ["checks"],
      "additionalProperties": true,
      "properties": { "checks": { "type": "array", "items": { "$ref": "#/definitions/verifyCheck" }, "minItems": 1 } }
    }
  }
}
