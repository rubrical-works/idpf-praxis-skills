{
  "$schema": "./test-coverage-conventions-schema.json",
  "_meta": {
    "description": "Language conventions for pairing source files with their tests. Consumed by ../scripts/test-coverage-audit.js. Project-specific overrides go in framework-config.json under testCoverageAudit -- see the Project Override section of ../SKILL.md for worked examples, including a dot-directory source root with a non-mirroring test root, and for how {dir} and {stem} substitute inside override testPatterns.",
    "version": 1
  },
  "languages": {
    "typescript": {
      "sourceExtensions": [".ts", ".tsx"],
      "testPatterns": [
        "{dir}/{stem}.test.ts",
        "{dir}/{stem}.test.tsx",
        "{dir}/{stem}.spec.ts",
        "{dir}/{stem}.spec.tsx",
        "{dir}/__tests__/{stem}.ts",
        "{dir}/__tests__/{stem}.tsx",
        "{dir}/__tests__/{stem}.test.ts",
        "tests/**/{stem}.test.ts",
        "tests/**/{stem}.test.tsx",
        "tests/**/{stem}.spec.ts",
        "tests/**/{stem}.spec.tsx",
        "test/**/{stem}.test.ts",
        "test/**/{stem}.spec.ts",
        "__tests__/**/{stem}.test.ts"
      ],
      "excludePatterns": ["**/*.d.ts", "**/node_modules/**"]
    },
    "javascript": {
      "sourceExtensions": [".js", ".jsx", ".mjs", ".cjs"],
      "testPatterns": [
        "{dir}/{stem}.test.js",
        "{dir}/{stem}.test.jsx",
        "{dir}/{stem}.spec.js",
        "{dir}/{stem}.spec.jsx",
        "{dir}/__tests__/{stem}.js",
        "{dir}/__tests__/{stem}.test.js",
        "tests/**/{stem}.test.js",
        "tests/**/{stem}.test.jsx",
        "tests/**/{stem}.spec.js",
        "tests/**/{stem}.spec.jsx",
        "test/**/{stem}.test.js",
        "test/**/{stem}.spec.js",
        "__tests__/**/{stem}.test.js"
      ],
      "excludePatterns": ["**/node_modules/**"]
    },
    "svelte": {
      "sourceExtensions": [".svelte"],
      "testPatterns": [
        "{dir}/{stem}.test.ts",
        "{dir}/{stem}.test.js",
        "{dir}/{stem}.spec.ts",
        "{dir}/{stem}.spec.js",
        "tests/**/{stem}.test.ts",
        "tests/**/{stem}.test.js",
        "tests/**/{stem}.spec.ts",
        "tests/**/{stem}.spec.js",
        "test/**/{stem}.test.ts",
        "test/**/{stem}.test.js",
        "__tests__/**/{stem}.test.ts"
      ]
    },
    "vue": {
      "sourceExtensions": [".vue"],
      "testPatterns": [
        "{dir}/{stem}.test.ts",
        "{dir}/{stem}.test.js",
        "{dir}/{stem}.spec.ts",
        "{dir}/{stem}.spec.js",
        "{dir}/__tests__/{stem}.spec.ts",
        "{dir}/__tests__/{stem}.spec.js",
        "tests/**/{stem}.spec.ts",
        "tests/**/{stem}.spec.js",
        "tests/**/{stem}.test.ts",
        "tests/**/{stem}.test.js",
        "test/**/{stem}.spec.ts",
        "test/**/{stem}.test.ts"
      ],
      "_note": "Vue tests are .ts/.js files, never .vue — this entry maps a .vue source to a TypeScript or JavaScript test, as svelte already does. Mirror patterns carry ** from the first commit so the entry does not ship with the #291 anchoring defect built in."
    },
    "python": {
      "sourceExtensions": [".py"],
      "testPatterns": [
        "{dir}/test_{stem}.py",
        "{dir}/{stem}_test.py",
        "tests/test_{stem}.py",
        "tests/{stem}_test.py",
        "test/test_{stem}.py",
        "tests/**/test_{stem}.py",
        "tests/**/{stem}_test.py",
        "test/**/test_{stem}.py",
        "test/**/{stem}_test.py"
      ],
      "excludePatterns": ["**/__init__.py", "**/conftest.py", "**/setup.py"]
    },
    "go": {
      "sourceExtensions": [".go"],
      "pairingScope": "directory",
      "testPatterns": ["{dir}/{stem}_test.go"],
      "excludePatterns": [
        "**/*_test.go",
        "**/vendor/**",
        "**/*.pb.go",
        "**/*_grpc.pb.go",
        "**/zz_generated*.go",
        "**/mock_*.go",
        "**/*_mock.go",
        "**/*_string.go",
        "**/doc.go"
      ]
    },
    "rust": {
      "sourceExtensions": [".rs"],
      "testPatterns": ["tests/{stem}.rs", "{dir}/tests/{stem}.rs"],
      "inlineTests": true,
      "_note": "Rust commonly uses #[cfg(test)] inline modules; inlineTests:true means audit checks for a 'mod tests' block in the same file before reporting missing tests."
    },
    "ruby": {
      "sourceExtensions": [".rb"],
      "testPatterns": [
        "{dir}/{stem}_spec.rb",
        "spec/{stem}_spec.rb",
        "spec/**/{stem}_spec.rb",
        "{dir}/{stem}_test.rb",
        "test/{stem}_test.rb",
        "test/**/{stem}_test.rb"
      ],
      "excludePatterns": ["**/db/migrate/**"]
    },
    "elixir": {
      "sourceExtensions": [".ex"],
      "testPatterns": ["test/{stem}_test.exs", "test/**/{stem}_test.exs"]
    },
    "java": {
      "sourceExtensions": [".java"],
      "testPatterns": [
        "{dir}/{stem}Test.java",
        "src/test/java/**/{stem}Test.java",
        "src/test/java/**/{stem}Tests.java",
        "src/test/java/**/{stem}IT.java",
        "src/test/java/**/{stem}TestCase.java",
        "**/src/test/java/**/{stem}Test.java",
        "**/src/test/java/**/{stem}Tests.java",
        "**/src/test/java/**/{stem}IT.java",
        "**/src/test/java/**/{stem}TestCase.java"
      ]
    },
    "dart": {
      "sourceExtensions": [".dart"],
      "testPatterns": [
        "test/**/{stem}_test.dart",
        "test/{stem}_test.dart",
        "{dir}/{stem}_test.dart"
      ],
      "excludePatterns": [
        "**/*.g.dart",
        "**/*.freezed.dart",
        "**/*.mocks.dart",
        "**/*.gr.dart",
        "**/*.config.dart",
        "**/generated_plugin_registrant.dart",
        "**/.dart_tool/**"
      ],
      "_note": "flutter test and dart test require test files to end in _test.dart and live under test/, and the community mirrors the lib/ tree exactly — so the mirror pattern carries ** from the first commit rather than acquiring it in a later repair (#291/#292/#296). Exclusions are build_runner and Flutter tooling output, which in a real Flutter app routinely outnumber hand-written files in lib/; they sit on this entry per #294's placement decision. The colocated form is legal though uncommon."
    },
    "csharp": {
      "sourceExtensions": [".cs"],
      "testPatterns": [
        "{dir}/{stem}Tests.cs",
        "{dir}/{stem}.Tests.cs",
        "**/{stem}Tests.cs",
        "**/{stem}.Tests.cs"
      ]
    }
  },
  "ignoredSourcePatterns": [
    "**/index.ts",
    "**/index.js",
    "**/index.tsx",
    "**/index.jsx",
    "**/types.ts",
    "**/types.d.ts",
    "**/*.config.ts",
    "**/*.config.js",
    "**/*.config.mjs",
    "**/migrations/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/dist/**",
    "**/build/**"
  ]
}
