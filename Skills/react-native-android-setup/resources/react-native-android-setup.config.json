    {
      "id": "metro-detached",
      "kind": "practice",
      "lessons": [10],
      "summary": "Start Metro detached so it survives the shell that launched it.",
      "platforms": {
        "windows": {
          "status": "verified",
          "check": "Get-NetTCPConnection -LocalPort {port} -State Listen -ErrorAction SilentlyContinue  # Metro listening",
          "apply": "Start-Process -WindowStyle Minimized cmd.exe -ArgumentList '/c','npx react-native start --port {port}'",
          "requiresAdmin": false,
          "requiresReboot": false
        },
        "macos": {
          "status": "declared-but-untested",
          "check": "lsof -nP -iTCP:{port} -sTCP:LISTEN",
          "apply": "nohup npx react-native start --port {port} > metro.log 2>&1 &",
          "requiresAdmin": false,
          "requiresReboot": false
        },
        "linux": {
          "status": "declared-but-untested",
          "check": "ss -ltn 'sport = :{port}'",
          "apply": "nohup npx react-native start --port {port} > metro.log 2>&1 &",
          "requiresAdmin": false,
          "requiresReboot": false
        }
      }
    },
