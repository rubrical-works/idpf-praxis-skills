{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "react-native-android-setup.config.schema.json",
  "type": "object",
  "required": ["version", "source", "toolRoot", "paths", "resume", "sdkPackages", "cliSyntax", "downloads", "metro", "items", "practices"],
  "additionalProperties": true,
  "definitions": {
    "toolRootPath": {
      "type": "string",
      "pattern": "^\\{toolRoot\\}/[^\\\\]*$",
      "description": "A path derived from the tool root, forward slashes only."
    },
    "commandOrSteps": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      ]
    },
    "platformEntry": {
      "type": "object",
      "required": ["status", "check", "apply", "requiresAdmin", "requiresReboot"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["verified", "declared-but-untested"] },
        "check": { "type": "string", "minLength": 1 },
        "apply": { "$ref": "#/definitions/commandOrSteps" },
        "requiresAdmin": { "type": "boolean" },
        "requiresReboot": { "type": "boolean" }
      }
    },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "windows": { "$ref": "#/definitions/platformEntry" },
        "macos": { "$ref": "#/definitions/platformEntry" },
        "linux": { "$ref": "#/definitions/platformEntry" }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "kind", "lessons", "summary", "platforms"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "kind": { "type": "string", "enum": ["tool", "envVar", "folder", "osSetting", "practice"] },
        "lessons": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 },
          "minItems": 1,
          "uniqueItems": true
        },
        "summary": { "type": "string", "minLength": 1 },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "platforms": { "$ref": "#/definitions/platforms" }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "_description": { "type": "string" },
    "version": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["evidence", "pilotStack"],
      "additionalProperties": true
    },
    "toolRoot": {
      "type": "object",
      "required": ["question", "default", "pathSeparator"],
      "additionalProperties": true,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "default": { "type": "null" },
        "pathSeparator": { "const": "/" }
      }
    },
    "paths": {
      "type": "object",
      "required": ["sdk", "avd", "maestro", "maestroTemp"],
      "additionalProperties": { "$ref": "#/definitions/toolRootPath" }
    },
    "resume": {
      "type": "object",
      "required": ["stateFile", "records"],
      "additionalProperties": true,
      "properties": {
        "stateFile": { "type": "string" },
        "records": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "sdkPackages": {
      "type": "object",
      "required": ["resolveFrom", "always", "templates"],
      "additionalProperties": true,
      "properties": {
        "always": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "templates": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "cliSyntax": {
      "type": "object",
      "required": ["sdkmanager", "avdmanager"],
      "additionalProperties": true
    },
    "downloads": {
      "type": "object",
      "required": ["cmdlineTools", "maestro"],
      "additionalProperties": true,
      "properties": {
        "cmdlineTools": {
          "type": "object",
          "required": ["repositoryIndex", "archives", "installLayout"],
          "additionalProperties": true,
          "properties": {
            "archives": {
              "type": "object",
              "required": ["windows", "macos", "linux"],
              "additionalProperties": { "type": "string", "pattern": "^https://" }
            }
          }
        },
        "maestro": {
          "type": "object",
          "required": ["version", "archive"],
          "additionalProperties": true,
          "properties": {
            "version": { "type": "string" },
            "archive": { "type": "string", "pattern": "^https://" }
          }
        }
      }
    },
    "metro": {
      "type": "object",
      "required": ["defaultPort", "alternativePort"],
      "additionalProperties": true,
      "properties": {
        "defaultPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "alternativePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/entry" },
          { "properties": { "kind": { "not": { "const": "practice" } } } }
        ]
      }
    },
    "practices": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/definitions/entry" },
          { "properties": { "kind": { "const": "practice" } } }
        ]
      }
    }
  }
}
