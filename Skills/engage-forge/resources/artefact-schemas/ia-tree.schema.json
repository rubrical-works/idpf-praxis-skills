{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ia-tree.schema.json",
  "title": "Nested-list information-architecture sitemap",
  "description": "A hierarchical sitemap. Each node has a label and optional children. Used by IA-first and atomic-design paths.",
  "type": "object",
  "required": ["artefactType", "title", "root"],
  "properties": {
    "artefactType": { "const": "ia-tree" },
    "title": { "type": "string", "minLength": 1 },
    "root": { "$ref": "#/definitions/node" }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/node" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
