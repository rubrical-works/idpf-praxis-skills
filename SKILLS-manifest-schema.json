{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SKILLS Manifest",
  "description": "Schema for the skills distribution manifest consumed by px-manager for installs, updates, and rename migrations.",
  "type": "object",
  "required": ["$schema", "version", "skills"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "description": "Manifest format version (semver)"
    },
    "skills": {
      "type": "object",
      "description": "Map of skill name to skill metadata",
      "additionalProperties": {
        "$ref": "#/definitions/skillEntry"
      }
    },
    "deprecated": {
      "type": "array",
      "description": "Skills that have been removed from distribution",
      "items": {
        "$ref": "#/definitions/deprecatedEntry"
      }
    }
  },
  "definitions": {
    "skillEntry": {
      "type": "object",
      "required": ["version", "type", "category", "path"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "description": "Skill version (semver)"
        },
        "type": {
          "type": "string",
          "enum": ["injector", "invokable", "reference", "educational"],
          "description": "Skill consumption type"
        },
        "category": {
          "type": "string",
          "description": "Skill category for grouping"
        },
        "path": {
          "type": "string",
          "description": "Relative path to skill directory"
        },
        "renamed": {
          "$ref": "#/definitions/renamedEntry"
        },
        "hostSetup": {
          "$ref": "#/definitions/hostSetupEntry"
        }
      }
    },
    "hostSetupEntry": {
      "type": "object",
      "description": "Host-setup metadata for a skill that prepares a host machine, copied from the hostSetup block of the skill's resources/<skill>.config.json by build-skills-manifest.js. Present only on skills that declare it.",
      "required": ["hostKeys", "automates", "leavesToUser", "os"],
      "additionalProperties": false,
      "properties": {
        "hostKeys": {
          "type": "array",
          "description": "Host answers the skill reads, each with the question that asks for it",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "question"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "question": { "type": "string", "minLength": 1 }
            }
          }
        },
        "automates": {
          "type": "array",
          "description": "Steps the skill carries out (each with the user's consent)",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "leavesToUser": {
          "type": "array",
          "description": "Steps the skill does not carry out and leaves to the user",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "os": {
          "type": "object",
          "description": "Operating systems the skill is verified on, and those declared but untested",
          "required": ["verified", "untested"],
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "array",
              "items": { "type": "string", "enum": ["windows", "macos", "linux"] },
              "uniqueItems": true
            },
            "untested": {
              "type": "array",
              "items": { "type": "string", "enum": ["windows", "macos", "linux"] },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "renamedEntry": {
      "type": "object",
      "required": ["from", "since", "autoMigrate"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "description": "Previous skill name"
        },
        "since": {
          "type": "string",
          "description": "Skill version when rename took effect"
        },
        "autoMigrate": {
          "type": "boolean",
          "description": "Whether px-manager should auto-migrate existing installations"
        }
      }
    },
    "deprecatedEntry": {
      "type": "object",
      "required": ["name", "since", "reason"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Deprecated skill name"
        },
        "since": {
          "type": "string",
          "description": "Version when deprecation took effect"
        },
        "reason": {
          "type": "string",
          "description": "Why the skill was deprecated"
        },
        "replacedBy": {
          "type": "string",
          "description": "Skill that replaces this one, if any"
        }
      }
    }
  }
}
