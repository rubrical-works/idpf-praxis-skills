    "godot-mobile-setup": {
      "version": "1.1.0",
      "type": "invokable",
      "category": "devops",
      "path": "Skills/godot-mobile-setup",
      "hostSetup": {
        "hostKeys": [
          {
            "key": "toolRoot",
            "question": "Where should the Godot editor, its export templates and editor data, the Android SDK and the downloads live? Give an absolute folder path on a drive with room for them (export templates alone are over 1 GB per build)."
          }
        ],
        "automates": [
          "Godot editor download and unpack under the tool root: the standard build for GDScript, the .NET build for C#",
          "Self-contained editor mode, so editor data, settings and export templates stay under the tool root",
          "Export templates matching the editor version and build",
          ".NET SDK install for a C# project",
          "JDK 17 install and the JAVA_HOME user variable (Android)",
          "Android command-line tools and the SDK, platform, build-tools, NDK and CMake packages under the tool root (Android)",
          "ANDROID_HOME and PATH user variables, which the editor reads as its Java SDK and Android SDK paths (Android)",
          "Install verification: headless editor run and an export-templates version check, reported pass or fail per check"
        ],
        "leavesToUser": [
          "iOS export: it needs macOS with Xcode, which this skill does not install; on Windows and Linux iOS export is not possible",
          "Running admin-phase installs (JDK, .NET SDK) from an elevated shell",
          "Opening a new terminal after environment variables change, before the editor's first launch",
          "Setting Java SDK Path and Android SDK Path in Editor Settings by hand when an existing editor settings file already holds other values",
          "Release keystores, signing and store submission",
          "Creating the project, its export presets and the Android build template"
        ],
        "os": {
          "verified": [
            "windows"
          ],
          "untested": [
            "macos",
            "linux"
          ]
        }
      }
    },
